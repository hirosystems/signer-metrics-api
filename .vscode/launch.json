{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/src/index.ts"],
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_SKIP_IGNORE": "true",
        "NETWORK": "testnet",
        "PGDATABASE": "postgres",
        "PGHOST": "localhost",
        "PGPORT": "5432",
        "PGUSER": "postgres",
        "PGPASSWORD": "postgres",
        "STACKS_NODE_RPC_HOST": "127.0.0.1",
        "STACKS_NODE_RPC_PORT": "20443",
        "REDIS_URL": "redis://127.0.0.1:8379",
      },
      "killBehavior": "polite",
      "preLaunchTask": "npm: testenv:run",
      "postDebugTask": "npm: testenv:stop",
      "nodeVersionHint": 24
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Generate OpenAPI spec",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/util/openapi-generator.ts"],
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_SKIP_IGNORE": "true"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Unit tests",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "--test", "--test-timeout=3600000"],
      "args": [
        "${workspaceFolder}/tests/unit/helpers.test.ts",
        "${workspaceFolder}/tests/unit/chunk-parsing.test.ts"
      ],
      "cwd": "${workspaceFolder}",
      "outputCapture": "std",
      "console": "internalConsole",
      "env": { "NODE_ENV": "test" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "DB tests (Docker)",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/tests/db/run-db-tests.ts"],
      "cwd": "${workspaceFolder}",
      "outputCapture": "std",
      "console": "internalConsole"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "csv-to-json",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/testing/csv-to-json.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current js File",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current TS File (tsx)",
      "runtimeExecutable": "tsx",
      "args": ["${file}"],
      "cwd": "${fileDirname}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.app.json"
      }
    }
  ]
}
