{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/src/index.ts"],
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_SKIP_IGNORE": "true",
        "NETWORK": "testnet",
        "PGDATABASE": "postgres",
        "PGHOST": "localhost",
        "PGPORT": "5432",
        "PGUSER": "postgres",
        "PGPASSWORD": "postgres",
        "STACKS_NODE_RPC_HOST": "127.0.0.1",
        "STACKS_NODE_RPC_PORT": "20443",
        "REDIS_URL": "redis://127.0.0.1:8379",
      },
      "killBehavior": "polite",
      "nodeVersionHint": 24
    },
    {
      "type": "node",
      "request": "launch",
      "name": "test: unit",
      "runtimeExecutable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1",
        "${workspaceFolder}/tests/unit/**/*.test.ts"
      ],
      "outputCapture": "std",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test"
      },
    },
    {
      "type": "node",
      "request": "launch",
      "name": "test: db",
      "runtimeExecutable": "tsx",
      "args": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1",
        "--test-global-setup=${workspaceFolder}/tests/db/setup.ts",
        "${workspaceFolder}/tests/db/**/*.test.ts"
      ],
      "outputCapture": "std",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test"
      },
    },
  ]
}
