{
  "name": "@stx-labs/signer-metrics-api",
  "description": "A microservice that indexes signer data from the Stacks blockchain and exposes it via JSON REST API endpoints",
  "version": "1.0.2",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "author": "Stacks Labs",
  "license": "GPL-3.0",
  "scripts": {
    "build": "rimraf ./dist && tsc --project tsconfig.build.json",
    "build:tests": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "start": "node ./dist/src/index.js",
    "start-ts": "tsx ./src/index.ts",
    "test:unit": "node --import tsx --test --test-timeout=600000 tests/unit/helpers.test.ts tests/unit/chunk-parsing.test.ts",
    "test:db": "NODE_ENV=test node --import tsx --test --test-global-setup=./tests/db/setup.ts --test-concurrency=1 ./tests/db/**/*.test.ts",
    "test:coverage": "c8 -r lcov -r text npm run test",
    "testenv:run": "docker compose -f docker/docker-compose.dev.postgres.yml -f docker/docker-compose.dev.redis.yml up",
    "testenv:stop": "docker compose -f docker/docker-compose.dev.postgres.yml -f docker/docker-compose.dev.redis.yml down -v -t 0",
    "testenv:logs": "docker compose -f docker/docker-compose.dev.postgres.yml -f docker/docker-compose.dev.redis.yml logs -t -f",
    "migrate": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate -j ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "vendor-secp256k1": "mkdir -p src/vendored/@noble/secp256k1 && cp node_modules/@noble/secp256k1/index.ts src/vendored/@noble/secp256k1/index.ts",
    "generate:openapi": "rimraf ./tmp && tsx ./util/openapi-generator.ts",
    "generate:git-info": "rimraf .git-info && node_modules/.bin/api-toolkit-git-info"
  },
  "prettier": "@stacks/prettier-config",
  "devDependencies": {
    "@stacks/api-test-toolkit": "^1.13.0",
    "@stacks/prettier-config": "^0.0.10",
    "@stacks/eslint-config": "3.0.0-develop.2",
    "@types/supertest": "^6.0.2",
    "c8": "^10.0.0",
    "dotenv": "^16.4.7",
    "eslint": "10.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-tsdoc": "0.5.2",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@noble/secp256k1": "^2.2.3",
    "@sinclair/typebox": "^0.34.48",
    "@stacks/api-toolkit": "^1.13.0",
    "@stacks/node-publisher-client": "^2.0.5",
    "@stacks/transactions": "^7.4.0",
    "@types/node": "^24.0.0",
    "bignumber.js": "^9.1.2",
    "date-fns": "^4.1.0",
    "env-schema": "^6.0.0",
    "fastify": "^5.8.2",
    "fastify-metrics": "^12.1.0",
    "node-pg-migrate": "^6.2.2",
    "p-queue": "^6.6.2",
    "socket.io": "^4.8.1"
  }
}
