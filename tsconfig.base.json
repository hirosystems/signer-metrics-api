{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["./src/api/@types", "./node_modules/@types"],
    "allowSyntheticDefaultImports": false,
    "esModuleInterop": false
  }
}
